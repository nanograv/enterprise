[run]
source = enterprise
omit =
    enterprise/__init__*
    enterprise/signals/__init__*
plugins =
    coverage_conditional_plugin

[report]
exclude_also = 
    no cover: start(?s:.)*?no cover: stop

[coverage_conditional_plugin]
rules =
    "sys_version_info >= (3, 10)": py-gte-310
    "sys_version_info < (3, 10)": py-lt-310
